<Project Sdk="Microsoft.NET.Sdk">

  <!-- Crucible's mixer, by ear (ADR 0082): a game assembly the launcher loads
       by path. Clicks at exact times, a tone sweeping left and right, a bus
       low-passed and sent to the reverb in turns, and music switching on the
       bar. With check=1, headless, it mixes offline and checks the clicks'
       spacing to the frame. -->

  <PropertyGroup>
    <RootNamespace>Crucible.Samples.Metronome</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine isn't copied: at runtime it comes from the default load
         context, as for every game (ADR 0011). -->
    <ProjectReference Include="../../src/managed/Crucible.Engine/Crucible.Engine.csproj" Private="false" />
    <ProjectReference Include="../../tools/Crucible.Generators/Crucible.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
