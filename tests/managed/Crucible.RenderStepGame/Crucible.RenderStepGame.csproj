<Project Sdk="Microsoft.NET.Sdk">

  <!-- The batched command API's GPU test from C# (ADR 0058): a game the
       launcher loads by path, whose C# render step draws through command
       records; it reads the frame back and checks it. -->

  <PropertyGroup>
    <RootNamespace>Crucible.RenderStepGame</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Diorama's PNG writer, for the canvas test's capture. -->
    <Compile Include="../../../samples/Diorama/Png.cs" Link="Png.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine comes from the default load context at runtime (ADR 0011). -->
    <ProjectReference Include="../../../src/managed/Crucible.Engine/Crucible.Engine.csproj" Private="false" />
    <ProjectReference Include="../../../tools/Crucible.Generators/Crucible.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
