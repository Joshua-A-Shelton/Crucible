<Project>
  <!-- NativeAOT link inputs that CMake generates (cmake/CrucibleDotnet.cmake):
       direct P/Invoke into the C++ core, and its static libraries for AOT
       executables (ADR 0011). -->
  <Import Project="$(CrucibleNativeProps)" Condition="'$(CrucibleNativeProps)' != '' and Exists('$(CrucibleNativeProps)')" />

  <!-- A NativeAOT static library leaves the final link to whoever consumes it
       (the AOT launcher), and that link needs the .NET runtime's support
       libraries. NativeAOT computes them in SetupOSSpecificProps; this writes
       them to a linker response file so CMake doesn't hard-code a list that
       changes between .NET versions. -->
  <Target Name="CrucibleWriteNativeLinkInputs"
          AfterTargets="SetupOSSpecificProps"
          Condition="'$(NativeLib)' == 'Static' and '$(CrucibleLinkInputsFile)' != ''">
    <!-- Unix: library paths, then system libraries as -l<name>. Windows (MSVC
         link.exe): quoted library paths, then the SDK's .lib names. -->
    <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
      <_CrucibleLinkInput Include="@(NativeLibrary->'%(FullPath)')" />
      <_CrucibleLinkInput Include="@(NativeSystemLibrary->'-l%(Identity)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <_CrucibleLinkInput Include="@(NativeLibrary->'&quot;%(FullPath)&quot;')" />
      <_CrucibleLinkInput Include="@(SdkNativeLibrary)" />
    </ItemGroup>
    <WriteLinesToFile File="$(CrucibleLinkInputsFile)"
                      Lines="@(_CrucibleLinkInput)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
