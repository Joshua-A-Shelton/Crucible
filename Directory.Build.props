<Project>
  <!-- Settings shared by every C# project. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Turns on .NET's AOT and trim analyzers, which are errors for engine,
         plugin, game, and test code (ADR 0001). -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Every project can be published with NativeAOT for both target
         platforms, so every restore includes the AOT compiler and both
         platforms' packages: the lock files then stay identical between a
         build and a publish.

         PublishAot is set only while restoring; publishes pass it on the
         command line. Set during a build, it would switch on AOT-style
         defaults in the JIT build's runtimeconfig.json, one of which turns off
         native hosting, which the JIT launcher needs (ADR 0011). -->
    <PublishAot Condition="'$(MSBuildIsRestoring)' == 'true'">true</PublishAot>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>

    <!-- CMake passes the real version and an artifacts path under its build
         directory; these defaults cover building from an IDE. -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)build/artifacts</ArtifactsPath>
    <!-- Where the binding generator writes (ADR 0017). IDE builds use the
         debug preset's output, so configure with CMake first. -->
    <CrucibleGeneratedDir Condition="'$(CrucibleGeneratedDir)' == ''">$(MSBuildThisFileDirectory)build/debug/generated</CrucibleGeneratedDir>

    <!-- Packages are pinned by lock file, like the hashes in
         cmake/CrucibleDependencies.cmake; CI refuses to restore anything else. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
