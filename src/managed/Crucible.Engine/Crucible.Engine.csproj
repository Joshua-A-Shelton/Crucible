<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crucible</RootNamespace>
    <!-- Emits a runtimeconfig.json so the native launcher can start .NET with
         this library as its first assembly (ADR 0011). -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- LibraryImport's generated code uses pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C#/C++ bindings, generated from annotated C++ headers (ADR 0017). -->
    <Compile Include="$(CrucibleGeneratedDir)/managed/Bindings.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests check the generated layout checks, which are internal. -->
    <InternalsVisibleTo Include="Crucible.Engine.Tests" />
  </ItemGroup>

</Project>
