<Project Sdk="Microsoft.NET.Sdk">

  <!-- The editor (ADR 0016, 0066): C#, loaded by CrucibleEditor as the
       launcher loads a game, so JIT only. An editor assembly (ADR 0002): it
       references the engine and the asset pipeline, never the reverse. -->

  <PropertyGroup>
    <RootNamespace>Crucible.Editor</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The asset pipeline's packages beside the editor (Dependencies.cs). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crucible.Editor.Tests" />
    <!-- The official Tilemaps plugin's checks (ADR 0123); the plugin itself sees only the public API. -->
    <InternalsVisibleTo Include="Tilemaps.Editor.Checks" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor's font: Noto Sans (SIL Open Font License, Fonts/OFL.txt);
         and its icons, Lucide 1.79.0's font and names (ISC, Fonts/lucide-LICENSE.txt; ADR 0124). -->
    <None Include="Fonts/NotoSans-Regular.ttf;Fonts/OFL.txt;Fonts/lucide.ttf;Fonts/lucide-codepoints.json;Fonts/lucide-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The editor's look (ADR 0129), read beside it and again when it changes. -->
    <None Include="Editor.crstyle" CopyToOutputDirectory="PreserveNewest" />
    <!-- The editor's own assets (ADR 0132): the sphere materials are shown on, from scripts/make-sphere.py. -->
    <None Include="EditorAssets/Sphere.gltf;EditorAssets/Sphere.gltf.crmeta" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Diorama's PNG writer, for the editor check's capture. -->
    <Compile Include="../../../samples/Diorama/Png.cs" Link="Png.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Crucible.Engine/Crucible.Engine.csproj" Private="false" />
    <ProjectReference Include="../Crucible.Assets/Crucible.Assets.csproj" />
    <ProjectReference Include="../../../tools/Crucible.Generators/Crucible.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
