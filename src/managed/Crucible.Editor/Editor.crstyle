{
  // The editor's look (ADR 0129): "Forge", neutral charcoal with a molten
  // orange accent, compact, hairline dividers. Tuned (ADR 0133): surfaces
  // a step apart, a neutral selection marked by an orange edge, outlined
  // fields. Layered over the engine's
  // default theme; read at start and again whenever this file changes, so
  // it can be tuned while the editor runs. Extensions read the tokens
  // through editor.Theme.
  "Tokens": {
    "page": "#121212",
    "panel": "#1f1f1f",
    "strip": "#171717",
    "header": "#262626",
    "field": "#181818",
    "control": "#2a2a2a",
    "hover": "#2c2c2c",
    "pressed": "#242424",
    "divider": "#353535",
    "edge": "#3d3d3d",
    "text": "#e8e8e8",
    "muted": "#8f8f8f",
    "accent": "#ff7418",
    "on-accent": "#1a1a1a",
    "selection": "#3a3a3a",
    "selection-edge": "@accent",
    "title-glow": "@accent/55%",
    "tab-glow": "@accent/35%",
    "unsaved": "@accent",
    "playing": "@accent/25%",
    "warning": "#f0c060",
    "error": "#f07070",
    "override": "#5aa9ff",
    "icon": "@muted",
    "icon-selected": "@accent",
    "badge": "#101010d9",
    "radius": 5,
    "small-radius": 3
  },
  "Styles": [
    // Text: compact, 13px everywhere unless a style says otherwise.
    { "Selector": "*", "Set": { "FontSize": 13 } },
    { "Selector": "Label", "Set": { "Foreground": "@text" } },
    { "Selector": "Icon", "Set": { "Foreground": "@text" } },

    // Text that doesn't fit ends in "…" (ADR 0130); paths keep their file name.
    { "Selector": "DockTab Label", "Set": { "Trimming": "End" } },
    { "Selector": "ComboBox > DockPanel > Label", "Set": { "Trimming": "Path" } },
    { "Selector": "ListItem Label", "Set": { "Trimming": "End" } },
    { "Selector": "Label.status", "Set": { "Trimming": "End" } },
    { "Selector": "Label.asset-name", "Set": { "Trimming": "End" } },
    { "Selector": "Label.asset-crumb", "Set": { "Trimming": "Path" } },
    { "Selector": "Label.inspector-title", "Set": { "Trimming": "End" } },
    { "Selector": "DockPanel.build-row Label", "Set": { "Trimming": "End" } },
    { "Selector": "Label.row-detail", "Set": { "Trimming": "Path" } },

    // The engine's controls, in the editor's colors and density.
    { "Selector": "Button", "Set": { "Background": "@control", "CornerRadii": "@radius", "Padding": [10, 4, 10, 4], "BorderColor": "@accent" } },
    { "Selector": "Button:hover", "Set": { "Background": "@hover" } },
    { "Selector": "Button:pressed", "Set": { "Background": "@pressed" } },
    { "Selector": "Button:focus", "Set": { "BorderWidth": 1.5 } },
    { "Selector": "Button:disabled", "Set": { "Opacity": 1 } },
    { "Selector": "Button:disabled > Label", "Set": { "Foreground": "@muted" } },
    { "Selector": "Button:disabled Icon", "Set": { "Foreground": "@muted" } },
    { "Selector": "Button.primary", "Set": { "Background": "@accent" } },
    { "Selector": "Button.primary:hover", "Set": { "Background": "@accent/85%" } },
    { "Selector": "Button.primary > Label", "Set": { "Foreground": "@on-accent" } },

    { "Selector": "Toggle", "Set": { "Padding": 3, "CornerRadii": "@radius", "BorderColor": "@accent" } },
    { "Selector": "Toggle:focus", "Set": { "BorderWidth": 1.5 } },
    { "Selector": "ToggleBox", "Set": { "Width": 14, "Height": 14, "CornerRadii": "@small-radius", "Background": "@field", "BorderColor": "@edge", "BorderWidth": 1 } },
    { "Selector": "ToggleBox.on", "Set": { "Background": "@accent", "BorderColor": "@accent" } },
    { "Selector": "ToggleMark", "Set": { "Width": 6, "Height": 6, "Background": "@on-accent" } },

    { "Selector": "Slider", "Set": { "Height": 20, "BorderColor": "@accent" } },
    { "Selector": "SliderTrack", "Set": { "Background": "@edge" } },
    { "Selector": "SliderThumb", "Set": { "Width": 12, "Height": 12, "CornerRadii": 6, "Background": "@text" } },
    { "Selector": "SliderThumb:pressed", "Set": { "Background": "@accent" } },

    { "Selector": "ScrollThumb", "Set": { "Background": "@muted/40%" } },
    { "Selector": "ScrollThumb:hover", "Set": { "Background": "@muted/75%" } },

    { "Selector": "ListBox", "Set": { "Background": "@field", "CornerRadii": "@radius" } },
    // Trees fill their panels (the Hierarchy, the asset folders): on the panel, not sunk like a field's list.
    { "Selector": "TreeView ListBox", "Set": { "Background": "@panel" } },
    { "Selector": "ListItem", "Set": { "Padding": [8, 3, 8, 3], "CornerRadii": "@small-radius", "BorderColor": "@accent" } },
    { "Selector": "ListItem:hover", "Set": { "Background": "@hover" } },
    { "Selector": "ListItem.selected", "Set": { "Background": "@selection", "BorderColor": "@selection-edge", "BorderWidth": [2, 0, 0, 0] } },
    { "Selector": "ListItem:focus", "Set": { "BorderWidth": 1 } },
    { "Selector": "ListItem.selected:focus", "Set": { "BorderWidth": [2, 0, 0, 0] } },
    { "Selector": "ListItem.tree", "Set": { "Padding": [2, 2, 8, 2] } },
    { "Selector": "TreeExpander", "Set": { "Width": 14, "Foreground": "@muted" } },
    { "Selector": "TreeExpander:hover", "Set": { "Foreground": "@text" } },
    { "Selector": ".tree-drop", "Set": { "Foreground": "@accent" } },

    { "Selector": "Popup", "Set": { "Background": "@control", "CornerRadii": "@radius", "BorderColor": "@edge", "Padding": 3 } },
    { "Selector": ".tooltip", "Set": { "Background": "@control", "CornerRadii": "@small-radius", "BorderColor": "@edge", "Padding": [6, 2, 6, 2] } },
    { "Selector": "Label.tooltip-text", "Set": { "FontSize": 12 } },

    { "Selector": "ColorField", "Set": { "Background": "@field", "CornerRadii": "@small-radius", "BorderWidth": 1, "BorderColor": "@edge" } },
    { "Selector": "ColorField:focus", "Set": { "BorderColor": "@accent" } },
    { "Selector": "Spinner", "Set": { "Background": "@field", "CornerRadii": "@small-radius", "BorderWidth": 1, "BorderColor": "@edge" } },
    { "Selector": "Spinner:focus", "Set": { "BorderColor": "@accent" } },
    { "Selector": "SpinnerArrow", "Set": { "Width": 18, "Height": 18, "Foreground": "@muted" } },
    { "Selector": "SpinnerArrow:hover", "Set": { "Background": "@hover", "Foreground": "@text" } },
    { "Selector": "SpinnerArrow:pressed", "Set": { "Background": "@pressed" } },

    { "Selector": "ComboBox", "Set": { "Background": "@control", "CornerRadii": "@radius", "Padding": [8, 4, 6, 4], "MinWidth": 100, "BorderColor": "@accent" } },
    { "Selector": "ComboBox:hover", "Set": { "Background": "@hover" } },
    { "Selector": "ComboBox:focus", "Set": { "BorderWidth": 1.5 } },
    { "Selector": "ComboBoxArrow", "Set": { "Width": 14, "Height": 14, "Margin": [6, 0, 0, 0], "Foreground": "@muted" } },

    { "Selector": "TextField", "Set": { "Background": "@field", "Foreground": "@text", "CornerRadii": "@small-radius", "Padding": [6, 3, 6, 3], "MinWidth": 80, "BorderWidth": 1, "BorderColor": "@edge", "CaretColor": "@accent", "SelectionColor": "@accent/40%" } },
    { "Selector": "TextField:hover", "Set": { "BorderColor": "@muted/60%" } },
    { "Selector": "TextField:focus", "Set": { "BorderColor": "@accent", "BorderWidth": 1 } },
    { "Selector": "NumberField", "Set": { "MinWidth": 48 } },

    { "Selector": "MenuBar", "Set": { "Background": "#0000", "Padding": [4, 0, 4, 0] } },
    { "Selector": "Menu", "Set": { "MinWidth": 200 } },
    { "Selector": "MenuItem", "Set": { "Padding": [8, 3, 10, 3], "CornerRadii": "@small-radius", "Foreground": "@text" } },
    { "Selector": "MenuItem.bar", "Set": { "Padding": [8, 3, 8, 3] } },
    { "Selector": "MenuItem:hover", "Set": { "Background": "@hover" } },
    { "Selector": "MenuItem:focus", "Set": { "Background": "@hover" } },
    { "Selector": "MenuItem.open", "Set": { "Background": "@hover" } },
    { "Selector": "MenuSeparator", "Set": { "Margin": [6, 3, 6, 3], "Background": "@divider" } },
    { "Selector": "Label.shortcut", "Set": { "Foreground": "@muted" } },

    // The title bar glows orange at its top, fading into the strip (ADR 0133);
    // the menus and play buttons in it are clear, over the glow.
    { "Selector": "TitleBar", "Set": { "Background": "@strip", "GradientFrom": "@title-glow", "GradientLength": 1, "MinHeight": 30 } },
    // No title in the bar (ADR 0133): with editors of their own open, the
    // scene isn't necessarily what's being worked on. TitleBar.Title is still
    // kept up to date; remove the Visibility to show it again.
    { "Selector": "Label.title", "Set": { "Foreground": "@muted", "Visibility": "Collapsed" } },
    { "Selector": "WindowButton", "Set": { "Width": 40, "Foreground": "@text" } },
    { "Selector": "WindowButton:hover", "Set": { "Background": "@hover" } },
    { "Selector": "WindowButton:pressed", "Set": { "Background": "@pressed" } },

    // The shell: docking, tabs, splitters, the status bar.
    { "Selector": "DockPanel.editor", "Set": { "Background": "@page" } },
    { "Selector": "DockSpace.editor", "Set": { "Background": "@page" } },
    { "Selector": "DockGroup", "Set": { "Background": "@panel", "CornerRadii": "@radius", "Margin": 1 } },
    { "Selector": "StackPanel.dock-tabs", "Set": { "Background": "@strip" } },
    { "Selector": "DockTab", "Set": { "Padding": [10, 4, 6, 4], "Foreground": "@muted", "CornerRadii": [5, 5, 0, 0] } },
    { "Selector": "DockTab:hover", "Set": { "Background": "@hover" } },
    { "Selector": "DockTab.active", "Set": { "Background": "@panel", "GradientFrom": "@tab-glow", "GradientLength": 0.95, "Foreground": "@text", "BorderColor": "@accent" } },
    { "Selector": "DockTab Label", "Set": { "Foreground": "@muted" } },
    { "Selector": "DockTab.active Label", "Set": { "Foreground": "@text" } },
    // What a panel shows, after its title (ADR 0133): quieter, as the title bar's title was.
    { "Selector": "DockTab Label.tab-detail", "Set": { "Foreground": "@muted" } },
    { "Selector": "DockTab Icon.tab-separator", "Set": { "FontSize": 12, "Foreground": "@muted" } },
    { "Selector": "DropPreview", "Set": { "Foreground": "@accent" } },
    { "Selector": "Splitter", "Set": { "Background": "@page" } },
    { "Selector": "Splitter:hover", "Set": { "Background": "@accent/60%" } },
    { "Selector": "Splitter:pressed", "Set": { "Background": "@accent" } },
    { "Selector": "StatusBar", "Set": { "Background": "@strip", "Padding": [10, 2, 10, 2] } },
    { "Selector": "Label.status", "Set": { "Foreground": "@muted" } },
    { "Selector": "Label.status-project", "Set": { "Foreground": "@muted" } },
    // A tab's dot while its panel has unsaved changes (ADR 0133).
    { "Selector": ".tab-unsaved", "Set": { "Width": 6, "Height": 6, "CornerRadii": 3, "Background": "@unsaved" } },
    // While playing (ADR 0133): a faint glow along the status bar, so edits
    // made now (lost when play stops) aren't a surprise.
    { "Selector": "DockPanel.playing StatusBar", "Set": { "GradientFrom": "@playing", "GradientLength": 1 } },
    { "Selector": "Label.placeholder", "Set": { "Foreground": "@muted" } },
    { "Selector": "Label.log-warning", "Set": { "Foreground": "@warning" } },
    { "Selector": "Label.log-error", "Set": { "Foreground": "@error" } },

    // Toolbars: flat tools, the one that's on in the accent.
    { "Selector": ".toolbar-separator", "Set": { "Background": "@divider" } },
    { "Selector": "DockPanel.viewport-tools", "Set": { "Background": "@strip", "Padding": [6, 3, 6, 3] } },
    { "Selector": "StackPanel.viewport-tools", "Set": { "Background": "@strip", "Padding": [6, 3, 6, 3] } },
    { "Selector": "Button.tool", "Set": { "Padding": [8, 2, 8, 2], "Background": "@strip" } },
    { "Selector": "Button.tool:hover", "Set": { "Background": "@hover" } },
    { "Selector": "Button.on", "Set": { "Background": "@accent/30%" } },
    { "Selector": "Button.on Icon", "Set": { "Foreground": "@accent" } },
    { "Selector": "PlayToolbar", "Set": { "Padding": [0, 2, 0, 2] } },
    { "Selector": "PlayToolButton.tool", "Set": { "Foreground": "@text", "CornerRadii": "@small-radius" } },
    { "Selector": "PlayToolButton.tool:hover", "Set": { "Background": "@hover" } },
    { "Selector": "PlayToolButton.on", "Set": { "Background": "@accent/30%" } },
    { "Selector": "PlayToolButton.on Icon", "Set": { "Foreground": "@accent" } },
    { "Selector": "PlayToolButton:disabled", "Set": { "Opacity": 1 } },
    { "Selector": "PlayToolButton:disabled Icon", "Set": { "Foreground": "@muted/50%" } },

    // Icons (ADR 0124): Lucide's, following their button's state.
    { "Selector": "Icon.editor-icon", "Set": { "FontSize": 15, "Foreground": "@text" } },
    { "Selector": "Icon.small", "Set": { "FontSize": 13, "Foreground": "@muted" } },
    { "Selector": "Button.icon", "Set": { "Padding": [5, 2, 5, 2] } },
    { "Selector": "Button.icon:hover Icon.small", "Set": { "Foreground": "@text" } },
    { "Selector": "Toggle.icon", "Set": { "Padding": [5, 2, 5, 2], "Background": "@strip", "CornerRadii": "@small-radius" } },
    { "Selector": "Toggle.icon:hover", "Set": { "Background": "@hover" } },
    { "Selector": "Toggle.icon.on", "Set": { "Background": "@accent/30%" } },
    { "Selector": "Toggle.icon.on Icon", "Set": { "Foreground": "@accent" } },
    { "Selector": "Label.frame-time", "Set": { "Foreground": "@muted", "Margin": [8, 0, 0, 0] } },

    // Components' icons (ADR 0131): quiet, in the accent where they're
    // selected (a selected row, the Inspector's headers, Add Component's
    // highlighted row).
    { "Selector": "Icon.tree-icon", "Set": { "FontSize": 14, "Foreground": "@icon", "Margin": [0, 0, 4, 0] } },
    { "Selector": "Icon.tree-mark", "Set": { "FontSize": 11, "Foreground": "@icon", "Margin": [5, 0, 0, 0] } },
    { "Selector": "ListItem.selected Icon.tree-icon", "Set": { "Foreground": "@icon-selected" } },
    { "Selector": "ListItem.selected Icon.tree-mark", "Set": { "Foreground": "@text" } },
    { "Selector": "Icon.entity-icon", "Set": { "FontSize": 14, "Foreground": "@icon-selected" } },
    { "Selector": "PickerRow Icon", "Set": { "FontSize": 14, "Foreground": "@icon" } },
    { "Selector": "ListItem.selected PickerRow Icon", "Set": { "Foreground": "@icon-selected" } },
    { "Selector": "PickerRow.picker-category", "Set": { "Padding": [0, 6, 0, 1] } },
    { "Selector": "Label.picker-category", "Set": { "FontSize": 11, "Foreground": "@muted" } },
    { "Selector": ".picker-rule", "Set": { "Background": "@divider" } },

    // The inspector (ADR 0069): flat sections between hairlines; prefab
    // overrides in the accent.
    { "Selector": "DockPanel.inspector-header", "Set": { "Background": "@strip", "Padding": [8, 3, 6, 3] } },
    { "Selector": "Label.inspector-title", "Set": { "FontSize": 14 } },
    { "Selector": "StackPanel.inspector-sections", "Set": { "Background": "@divider" } },
    { "Selector": "StackPanel.inspector-sections > Label.placeholder", "Set": { "Background": "@panel", "Padding": [8, 6, 8, 6] } },
    { "Selector": "StackPanel.component", "Set": { "Background": "@panel", "Padding": [0, 0, 0, 6] } },
    { "Selector": "DockPanel.component-header", "Set": { "Background": "@header", "Padding": [8, 3, 8, 3] } },
    { "Selector": "StackPanel.component-fields", "Set": { "Margin": [8, 0, 8, 0] } },
    { "Selector": "IconButton", "Set": { "Foreground": "@muted", "CornerRadii": "@small-radius" } },
    { "Selector": "IconButton:hover", "Set": { "Background": "@hover", "Foreground": "@text" } },
    { "Selector": "IconButton:disabled", "Set": { "Opacity": 0.3 } },
    { "Selector": "Label.field-name", "Set": { "Foreground": "@muted" } },
    { "Selector": ".name-grip:hover", "Set": { "Background": "@accent/50%" } },
    { "Selector": ".name-grip:pressed", "Set": { "Background": "@accent" } },
    { "Selector": "Label.field-header", "Set": { "Foreground": "@text", "Margin": [0, 6, 0, 0] } },
    { "Selector": "Label.overridden", "Set": { "Foreground": "@override" } },
    { "Selector": "Label.field-warning", "Set": { "Foreground": "@warning" } },

    // The asset browser and drags (ADR 0071).
    { "Selector": "Label.asset-crumb", "Set": { "Foreground": "@muted", "Padding": [8, 3, 8, 3] } },
    { "Selector": "AssetTile", "Set": { "Padding": 4, "CornerRadii": "@radius", "Foreground": "@muted", "BorderColor": "@accent" } },
    { "Selector": "AssetTile:hover", "Set": { "Background": "@hover" } },
    { "Selector": "AssetTile.drop-over", "Set": { "Background": "@accent/45%" } },
    { "Selector": "AssetsPanel.drop-over", "Set": { "Background": "@accent/12%" } },
    { "Selector": "AssetTile.selected", "Set": { "Background": "@selection", "Foreground": "@text", "BorderColor": "@selection-edge", "BorderWidth": [0, 0, 0, 2] } },
    { "Selector": "AssetTile:focus", "Set": { "BorderWidth": 1 } },
    { "Selector": "AssetTile.selected:focus", "Set": { "BorderWidth": [0, 0, 0, 2] } },
    { "Selector": "Label.asset-name", "Set": { "FontSize": 12 } },
    // Tiles' pictures (ADR 0132): a kind's icon until there's an image; a
    // rendered thumbnail carries its kind in a corner.
    { "Selector": "Icon.asset-icon", "Set": { "Foreground": "@icon" } },
    { "Selector": "AssetTile.selected Icon.asset-icon", "Set": { "Foreground": "@icon-selected" } },
    { "Selector": "StackPanel.asset-badge", "Set": { "Background": "@badge", "CornerRadii": 10, "Width": 20, "Height": 20, "Margin": [0, 0, 1, 1] } },
    { "Selector": "Icon.asset-badge-icon", "Set": { "FontSize": 12, "Foreground": "@text" } },
    { "Selector": "Slider.tile-size", "Set": { "Margin": [8, 0, 8, 0] } },
    { "Selector": "Label.drag-preview", "Set": { "Background": "@control", "BorderColor": "@accent", "BorderWidth": 1, "CornerRadii": "@radius", "Padding": [8, 3, 8, 3] } },

    // The Build Settings window (ADR 0098): sections with a title over muted
    // hints, rows, and a primary Build.
    { "Selector": "BuildCard", "Set": { "Background": "@panel", "Padding": [10, 8, 10, 10], "BorderColor": "@accent" } },
    { "Selector": "BuildCard.drop-over", "Set": { "BorderWidth": 2 } },
    { "Selector": "Label.card-title", "Set": { "FontSize": 15 } },
    { "Selector": "Label.hint", "Set": { "Foreground": "@muted", "FontSize": 12 } },
    { "Selector": "DockPanel.build-row", "Set": { "Background": "@control", "CornerRadii": "@small-radius", "Padding": [8, 2, 4, 2] } },
    { "Selector": "Label.row-index", "Set": { "Foreground": "@muted", "Width": 18 } },
    { "Selector": "Label.row-detail", "Set": { "Foreground": "@muted", "FontSize": 12, "Margin": [8, 0, 0, 0] } },
    { "Selector": "Label.start-tag", "Set": { "Foreground": "@accent", "FontSize": 12, "Margin": [8, 0, 0, 0] } }
  ]
}
