# Writes a C++ file embedding compiled shaders (ADR 0048), run as
#   cmake -DOUTPUT=<file.cpp> -DSHADERS=<name=file.crshader;...> -P EmbedShaders.cmake
# The table it defines is what crucible::render::engineShader searches.

set(_arrays "")
set(_entries "")
set(_index 0)
foreach(_pair IN LISTS SHADERS)
    string(FIND "${_pair}" "=" _at)
    string(SUBSTRING "${_pair}" 0 ${_at} _name)
    math(EXPR _start "${_at} + 1")
    string(SUBSTRING "${_pair}" ${_start} -1 _file)
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _length)
    math(EXPR _size "${_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n    " _bytes "${_bytes}")
    string(APPEND _arrays "alignas(16) const uint8_t shader${_index}[] = {\n    ${_bytes}};\n\n")
    string(APPEND _entries "    {\"${_name}\", shader${_index}, ${_size}},\n")
    math(EXPR _index "${_index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp" "// Generated by EmbedShaders.cmake (ADR 0048). Do not edit.
#include <crucible/Shader.h>

#include <cstddef>
#include <cstdint>

namespace crucible::render {

namespace {

${_arrays}const EmbeddedShader table[] = {
${_entries}};

} // namespace

extern const EmbeddedShader* const embeddedShaders = table;
extern const size_t embeddedShaderCount = ${_index};

} // namespace crucible::render
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
